SITE_GATE_PASSWORD=replace-with-a-new-shared-secret
SESSION_SECRET=generate-a-random-secret-at-least-32-characters
PHONE_HASH_SECRET=generate-a-different-random-secret-at-least-24-characters
SUPABASE_URL=https://your-project.supabase.co
